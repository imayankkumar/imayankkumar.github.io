---
import { experience } from "../../data/career"
---

<ol class="timeline">
  {
    experience.map((job) => (
      <li>
        <h3 class="timeline__company">{job.company}</h3>
        <ul class="timeline__roles">
          {job.roles.map((role) => (
            <li>
              <strong>{role.title}</strong> · {role.period}
            </li>
          ))}
        </ul>
        <ul class="list">
          {job.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

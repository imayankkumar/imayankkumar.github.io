---
import SocialLinks from "./SocialLinks.astro"
import ThemeToggle from "./ThemeToggle.astro"
import MobileNav from "./MobileNav.astro"
import Button from "../ui/Button.astro"
import { site } from "../../data/site"
---

<div class="header-actions">
  <div class="header-actions__desktop">
    <SocialLinks />
    <ThemeToggle />
    <Button href={site.resume} class="header-actions__resume"> Resume </Button>
  </div>

  <div class="header-actions__mobile">
    <ThemeToggle />
    <MobileNav />
  </div>
</div>

<style>
  .header-actions {
    display: flex;
    align-items: center;
  }

  .header-actions__desktop {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }

  .header-actions__mobile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-actions__resume {
    margin-left: var(--space-2);
    padding-inline: 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .header-actions__desktop {
      display: flex;
    }

    .header-actions__mobile {
      display: none;
    }
  }
</style>

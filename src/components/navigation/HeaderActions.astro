---
import SocialLinks from "./SocialLinks.astro"
import ThemeToggle from "./ThemeToggle.astro"
import MobileNav from "./MobileNav.astro"
---

<div class="header-actions">
  <div class="header-actions__desktop">
    <SocialLinks />
    <ThemeToggle />
  </div>

  <div class="header-actions__mobile">
    <ThemeToggle />
    <MobileNav />
  </div>
</div>

<style>
  .header-actions {
    display: flex;
    align-items: center;
  }

  .header-actions__desktop {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }

  .header-actions__mobile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }


  @media (min-width: 900px) {
    .header-actions__desktop {
      display: flex;
    }

    .header-actions__mobile {
      display: none;
    }
  }
</style>

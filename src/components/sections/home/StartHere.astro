---
import Container from "../../layout/Container.astro"
import Section from "../../layout/Section.astro"
import Icon from "../../ui/Icon.astro"
import SectionHeader from "./SectionHeader.astro"
import { roadmapStages } from "../../../data/roadmap"
import { interviewCards } from "../../../data/interview"
import { getPublishedPosts, getRoadmapPosts, postUrl } from "../../../lib/blog"

// Real counts from the data, so the cards never claim more than is published.
const totalTopics = roadmapStages.reduce((n, s) => n + s.topics.length, 0)
const publishedTopics = (await getRoadmapPosts()).size
const ladders = interviewCards.filter((c) => c.kind === "ladder" && c.page).length
const latest = (await getPublishedPosts())[0]

const cards = [
  {
    icon: "grid" as const,
    tone: "blue",
    title: "Follow the roadmap",
    body: `Nine stages from Kotlin basics to system design, in learning order. ${publishedTopics} of ${totalTopics} topics published, with new ones every week.`,
    link: { label: "Start at stage 1", href: "/roadmap/" },
  },
  {
    icon: "briefcase" as const,
    tone: "violet",
    title: "Practice for interviews",
    body: `One question, then the follow-ups interviewers ask next, with a junior and a senior answer. ${ladders} topic${ladders === 1 ? "" : "s"} so far.`,
    link: { label: "Try a question", href: "/interview/" },
  },
  ...(latest
    ? [
        {
          icon: "pulse" as const,
          tone: "green",
          title: "Read the latest post",
          body: latest.data.title,
          link: { label: "Read it", href: postUrl(latest) },
        },
      ]
    : []),
]
---

<Section id="start" class="home-section" aria-labelledby="start-heading">
  <Container>
    <SectionHeader id="start-heading" title="Start here" />
    <ul class="start">
      {
        cards.map((card) => (
          <li>
            <a class="start__card" href={card.link.href}>
              <span class:list={["icon-tile", `icon-tile--${card.tone}`]}>
                <Icon name={card.icon} size={22} />
              </span>
              <span class="start__title">{card.title}</span>
              <span class="start__body">{card.body}</span>
              <span class="start__link">
                {card.link.label}
                <Icon name="arrow-right" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>

<style>
  .start {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .start {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .start > li {
    display: flex;
  }

  .start__card {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-background);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .start__card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
  }

  .start__card:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .start__title {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .start__body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .start__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }
</style>

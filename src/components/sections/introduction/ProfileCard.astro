---
import { Image } from "astro:assets"
import { profile } from "../../../data/profile"
import profilePhoto from "../../../assets/profile.png"
import StatusBadge from "./StatusBadge.astro"

interface Props {
  class?: string
}

const { class: className } = Astro.props

// Decorative backdrop: the Choreographer API FramePulse is built on.
const codeSnippet = `// FramePulse
// frame timing, powered by
// Choreographer

val choreographer =
  Choreographer.getInstance()

choreographer.postFrameCallback {
  frameTimeNanos ->
  onFrame(frameTimeNanos)
}`
---

<aside class:list={["profile-card", className]} aria-label="Profile highlights">
  <pre class="profile-card__code" aria-hidden="true"><code>{codeSnippet}</code></pre>

  <div class="profile-card__photo-wrap">
    <Image
      src={profilePhoto}
      alt={profile.image.alt}
      widths={[280, 420, 560]}
      sizes="(min-width: 900px) 270px, 64vw"
      format="webp"
      quality={80}
      class="profile-card__photo"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <ul class="profile-card__badges">
    {
      profile.highlights.map((item) => (
        <li>
          <a
            href={item.href}
            class="profile-card__badge-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <StatusBadge
              label={item.label}
              variant={item.variant}
              icon={item.icon}
              class="profile-card__badge"
            />
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .profile-card {
    --card-bg: linear-gradient(160deg, #f1f5fb 0%, #e4eaf5 100%);
    --code-color: #94a3b8;

    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 8 / 7;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--shadow-md);
  }

  :global([data-theme="dark"]) .profile-card {
    --card-bg: linear-gradient(160deg, #131c30 0%, #0e1526 100%);
    --code-color: #475569;
  }

  .profile-card__code {
    position: absolute;
    top: 7%;
    left: 6%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.55rem, 1.6vw, 0.68rem);
    line-height: 1.6;
    color: var(--code-color);
    white-space: pre;
    opacity: 0.75;
    user-select: none;
    pointer-events: none;
  }

  .profile-card__photo-wrap {
    position: absolute;
    z-index: 1;
    right: -2%;
    bottom: 0;
    width: 64%;
  }

  .profile-card__photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 12px 28px rgb(0 0 0 / 0.2));
  }

  .profile-card__badges {
    position: absolute;
    z-index: 2;
    left: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-card__badge-link {
    display: block;
    border-radius: 999px;
    transition: transform 150ms ease;
  }

  .profile-card__badge-link:hover {
    transform: translateY(-1px);
  }

  .profile-card__badge-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  :global(.profile-card__badge) {
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
  }

  @media (max-width: 480px) {
    .profile-card__badges {
      left: var(--space-3);
      bottom: var(--space-3);
    }

    :global(.profile-card__badge) {
      font-size: 0.8125rem;
    }
  }
</style>

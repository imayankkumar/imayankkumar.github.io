---
import { profile } from "../../../data/profile"
import { hero } from "../../../data/home"
import StatusBadge from "./StatusBadge.astro"
import CTAButtons from "./CTAButtons.astro"
import { getAndroidWeeklyFeatures } from "../../../lib/blog"

interface Props {
  class?: string
}

const { class: className } = Astro.props

// A count stays short as features add up; link the latest issue as proof.
const features = await getAndroidWeeklyFeatures()
const latest = features[0]
const issueNumber = latest?.name.match(/#(\d+)/)?.[1]
---

<div class:list={["introduction-content", className]}>
  <StatusBadge label={hero.badge} variant="role" />

  <h1 id="introduction-heading" class="introduction-content__title">
    {
      hero.lines.map((line) => (
        <span class="introduction-content__line">
          {line.map((part) =>
            part.highlight ? (
              <span class="introduction-content__highlight">{part.text}</span>
            ) : (
              part.text
            )
          )}
        </span>
      ))
    }
  </h1>

  <p class="introduction-content__bio">{hero.bio}</p>

  <CTAButtons />

  {
    latest && (
      <p class="introduction-content__proof">
        Featured in Android Weekly {features.length}{" "}
        {features.length === 1 ? "time" : "times"}, latest{" "}
        <a href={latest.url} target="_blank" rel="noopener noreferrer">
          {issueNumber ? `issue ${issueNumber}` : latest.name}
        </a>
      </p>
    )
  }
</div>

<style>
  .introduction-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    max-width: 38rem;
  }

  .introduction-content__title {
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--color-text);
  }

  .introduction-content__line {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .introduction-content__line {
      white-space: normal;
    }
  }

  .introduction-content__highlight {
    color: var(--color-primary);
  }

  .introduction-content__bio {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .introduction-content__proof {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .introduction-content__proof a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .introduction-content__proof a:hover {
    color: var(--color-primary);
  }
</style>

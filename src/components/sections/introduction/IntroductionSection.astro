---
import Container from "../../layout/Container.astro"
import Section from "../../layout/Section.astro"
import IntroductionContent from "./IntroductionContent.astro"
import ProfileCard from "./ProfileCard.astro"
---

<Section id="introduction" class="introduction-section" aria-labelledby="introduction-heading">
  <Container>
    <div class="introduction-section__grid">
      <IntroductionContent />
      <ProfileCard />
    </div>
  </Container>
</Section>

<style>
  :global(.section.introduction-section) {
    padding-block: var(--space-12) var(--space-12);
  }

  .introduction-section__grid {
    display: grid;
    align-items: center;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    :global(.section.introduction-section) {
      padding-block: var(--space-16) var(--space-8);
    }

    .introduction-section__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      gap: var(--space-16);
      padding-bottom: var(--space-16);
    }
  }
</style>

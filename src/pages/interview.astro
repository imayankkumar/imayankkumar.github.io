---
import BaseLayout from "../layouts/BaseLayout.astro"
import Container from "../components/layout/Container.astro"
import { roadmapStages } from "../data/roadmap"
import { interviewCards, type LadderCard } from "../data/interview"
import { getRoadmapPosts, postUrl } from "../lib/blog"

type PageLadder = LadderCard & { page: NonNullable<LadderCard["page"]> }

const published = await getRoadmapPosts()

// Only ladders with a finished full page are listed. Other cards in
// src/data/interview.ts stay hidden until their page is written.
const ladders = interviewCards.filter((c): c is PageLadder => c.kind === "ladder" && !!c.page)

const groups = roadmapStages
  .map((stage) => {
    const order = stage.topics.map((t) => t.id)
    const items = ladders
      .filter((l) => order.includes(l.topic))
      .sort((a, b) => order.indexOf(a.topic) - order.indexOf(b.topic))
    return { stage, items }
  })
  .filter((g) => g.items.length > 0)

const questionCount = ladders.reduce((n, l) => n + l.steps.length, 0)

// The next few roadmap topics that don't have a page yet, in roadmap order.
const done = new Set(ladders.map((l) => l.topic))
const comingNext = roadmapStages
  .flatMap((s) => s.topics)
  .filter((t) => !done.has(t.id))
  .slice(0, 3)

const topicTitle = new Map(roadmapStages.flatMap((s) => s.topics.map((t) => [t.id, t.title] as const)))
---

<BaseLayout
  title="Android Interview Questions, With Follow-ups · Mayank Kumar"
  description="Android and Kotlin interview questions the way interviews really go: one question, then the follow-ups, with a junior answer, a senior answer and code for each step."
>
  <main class="page">
    <Container>
      <div class="page__inner iv">
        <p class="page__eyebrow">Interview prep</p>
        <h1 class="page__title">Android interview questions, with the follow-ups</h1>
        <p class="page__lead">
          Interviews don't stop at the first question. Each page starts with one question and
          climbs through the follow-ups an interviewer asks next, with code, a junior answer, a
          senior answer, and what the interviewer is really checking.
        </p>

        <p class="iv__count">
          {ladders.length} {ladders.length === 1 ? "topic" : "topics"} · {questionCount} questions ·
          A new topic with each <a class="page__link" href="/roadmap/">roadmap</a> post
        </p>

        {
          groups.map(({ stage, items }) => (
            <section class="iv__stage" aria-labelledby={`iv-stage-${stage.number}`}>
              <h2 class="iv__stage-title" id={`iv-stage-${stage.number}`}>
                <span class="iv__stage-num" aria-hidden="true">{stage.number}</span>
                {stage.title}
              </h2>

              <ul class="iv__list">
                {items.map((l) => {
                  const post = published.get(l.topic)
                  const href = `/interview/${l.page.slug}/`
                  return (
                    <li class="lad">
                      <div class="lad__meta">
                        <span>{topicTitle.get(l.topic)}</span>
                        <span class="lad__level">{l.level}</span>
                        <span>{l.steps.length} questions</span>
                      </div>
                      <h3 class="lad__title">
                        <a href={href}>{l.steps[0].question}</a>
                      </h3>
                      <ol class="lad__steps" aria-label="Follow-ups">
                        {l.steps.slice(1).map((s) => (
                          <li>{s.question}</li>
                        ))}
                      </ol>
                      <div class="lad__links">
                        <a class="lad__start" href={href}>Start the ladder →</a>
                        {post && (
                          <a class="page__link" href={postUrl(post)}>Read the post first</a>
                        )}
                      </div>
                    </li>
                  )
                })}
              </ul>
            </section>
          ))
        }

        {
          comingNext.length > 0 && (
            <section class="iv__next">
              <h2>Coming next</h2>
              <p>
                {comingNext.map((t, i) => (
                  <>
                    {i > 0 && " · "}
                    {t.title}
                  </>
                ))}
              </p>
              <p class="iv__next-note">
                Each topic gets its interview page when its roadmap post goes out.
              </p>
            </section>
          )
        }
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .iv__count {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .iv__stage {
    margin-top: var(--space-12);
  }

  .iv__stage-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .iv__stage-num {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-base);
  }

  .iv__list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .lad {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color 0.15s ease;
  }

  .lad:hover {
    border-color: var(--color-primary);
  }

  .lad__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .lad__level {
    color: var(--color-primary);
  }

  .lad__title {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    font-weight: 650;
    line-height: 1.4;
  }

  .lad__title a:hover {
    color: var(--color-primary);
  }

  .lad__steps {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .lad__steps li::before {
    content: "↳ ";
    color: var(--color-primary);
  }

  .lad__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .lad__start {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
  }

  .lad__start:hover {
    background: var(--color-primary-hover);
  }

  .iv__next {
    margin-top: var(--space-12);
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .iv__next h2 {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 650;
    color: var(--color-text);
  }

  .iv__next-note {
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .lad {
      padding: var(--space-4);
    }
  }
</style>

---
import { render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import Container from "../../components/layout/Container.astro"
import { getPublishedPosts, getRoadmapPosts, postUrl, formatDate, readingTime, type Post } from "../../lib/blog"
import { findRoadmapTopic } from "../../data/roadmap"
import { site } from "../../data/site"
import AuthorNote from "../../components/blog/AuthorNote.astro"

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  // Posts are newest first, so the neighbour before a post is newer.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post }
const { Content } = await render(post)
const url = new URL(postUrl(post), Astro.site).href
const ogImage = post.data.ogImage ?? "/og-image.jpg"

// Roadmap posts show their stage and the next topic in that stage.
const roadmap = post.data.roadmap ? findRoadmapTopic(post.data.roadmap.topic) : undefined
const nextTopic = roadmap?.stage.topics[roadmap.index + 1]
const nextPost = nextTopic ? (await getRoadmapPosts()).get(nextTopic.id) : undefined

// "Main title: subtitle" titles show the subtitle on its own line.
const colonAt = post.data.title.indexOf(": ")
const titleMain = colonAt > 0 ? post.data.title.slice(0, colonAt + 1) : post.data.title
const titleSub = colonAt > 0 ? post.data.title.slice(colonAt + 2) : ""

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(ogImage, Astro.site).href,
  keywords: post.data.tags.join(", "),
  author: { "@id": `${new URL("/", Astro.site).href}#person`, "@type": "Person", name: site.name, url: new URL("/", Astro.site).href },
}
---

<BaseLayout
  title={`${post.data.seoTitle ?? post.data.title} · Mayank Kumar`}
  description={post.data.description}
  type="article"
  image={ogImage}
  imageAlt={post.data.ogImageAlt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <meta slot="head" property="article:published_time" content={post.data.pubDate.toISOString()} />
  <main class="page">
    <Container>
      <article class="page__inner">
        <p class="page__eyebrow">
          {roadmap ? (
            <a href={`/roadmap/#stage-${roadmap.stage.number}`}>Roadmap · Stage {roadmap.stage.number}: {roadmap.stage.title}</a>
          ) : (
            <a href="/blog/">Blog</a>
          )}
        </p>
        <h1 class="page__title">
          {titleMain}
          {titleSub && <span class="page__title-sub"> {titleSub}</span>}
        </h1>
        <p class="card__meta post__meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {" · "}{readingTime(post)}
          {post.data.updatedDate && <> · Updated {formatDate(post.data.updatedDate)}</>}
        </p>

        <div class="prose">
          <Content />
        </div>

        {
          roadmap && (
            <aside class="post-stage" aria-label="Android roadmap">
              <p class="post-stage__label">Stage {roadmap.stage.number}: {roadmap.stage.title}</p>
              {nextTopic ? (
                nextPost ? (
                  <p>Next in this stage: <a class="page__link" href={postUrl(nextPost)}>{nextTopic.title}</a></p>
                ) : (
                  <p>Coming next in this stage: {nextTopic.title}</p>
                )
              ) : (
                <p>This is the last topic in this stage.</p>
              )}
              <p><a class="page__link" href="/roadmap/">See the full roadmap</a></p>
            </aside>
          )
        }

        <AuthorNote />

        {
          (newer || older) && (
            <nav class="post-nav" aria-label="More posts">
              {older && (
                <a class="post-nav__link" href={postUrl(older)}>
                  <span class="post-nav__label">← Previous post</span>
                  <span class="post-nav__title">{older.data.title}</span>
                </a>
              )}
              {newer && (
                <a class="post-nav__link post-nav__link--newer" href={postUrl(newer)}>
                  <span class="post-nav__label">Next post →</span>
                  <span class="post-nav__title">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }

        {
          (post.data.linkedinUrl || post.data.xUrl) && (
            <p class="post__discuss">
              Discuss this post on{" "}
              {post.data.linkedinUrl && (
                <a class="page__link" href={post.data.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              )}
              {post.data.linkedinUrl && post.data.xUrl && " or "}
              {post.data.xUrl && (
                <a class="page__link" href={post.data.xUrl} target="_blank" rel="noopener noreferrer">X</a>
              )}.
            </p>
          )
        }
      </article>
    </Container>
  </main>
</BaseLayout>

<style>
  .post__meta {
    margin-top: var(--space-4);
  }

  .post-stage {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-12);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
  }

  .post-stage__label {
    font-weight: 650;
    color: var(--color-text);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color 0.15s ease;
  }

  .post-nav__link:hover,
  .post-nav__link:focus-visible {
    border-color: var(--color-primary);
  }

  .post-nav__link--newer {
    grid-column: 2;
    text-align: right;
  }

  .post-nav__label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .post-nav__title {
    font-weight: 600;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav__link--newer {
      grid-column: auto;
      text-align: left;
    }
  }

  .post__discuss {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Container from "../../components/layout/Container.astro"
import PostCard from "../../components/blog/PostCard.astro"
import { getPublishedPosts, getRoadmapPosts } from "../../lib/blog"
import { roadmapStages } from "../../data/roadmap"

const posts = await getPublishedPosts()
const roadmapPosts = await getRoadmapPosts()

// Roadmap posts are grouped by stage, in learning order. Everything else is newest first.
const stageGroups = roadmapStages
  .map((stage) => ({
    stage,
    posts: stage.topics.flatMap((t) => roadmapPosts.get(t.id) ?? []),
  }))
  .filter((group) => group.posts.length > 0)
const inStages = new Set(stageGroups.flatMap((g) => g.posts.map((p) => p.id)))
const otherPosts = posts.filter((p) => !inStages.has(p.id))
---

<BaseLayout
  title="Blog · Mayank Kumar"
  description="Android and Kotlin explained simply: one question per post, code checked on the current Kotlin version, and interview questions to test yourself."
>
  {posts.length === 0 && <meta slot="head" name="robots" content="noindex" />}
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="Mayank Kumar · Blog"
    href="/rss.xml"
  />
  <main class="page">
    <Container>
      <div class="page__inner">
        <p class="page__eyebrow">Blog</p>
        <h1 class="page__title page__title--one-line">
          Android and Kotlin, explained simply
        </h1>
        <p class="page__lead">
          Each post answers one question, with a plain explanation and code
          checked on the current Kotlin version. Roadmap posts also come with
          interview questions to test yourself.
        </p>

        {
          posts.length === 0 ? (
            <p class="page__section card__body">
              The first post is on its way.
            </p>
          ) : (
            <>
              {stageGroups.map(({ stage, posts: stagePosts }) => (
                <section
                  class="page__section"
                  aria-labelledby={`stage-${stage.number}-heading`}
                >
                  <h2
                    id={`stage-${stage.number}-heading`}
                    class="page__section-title"
                  >
                    Android Roadmap · Stage {stage.number}: {stage.title}
                  </h2>
                  <p class="post-group__meta">
                    In learning order · {stagePosts.length} of{" "}
                    {stage.topics.length} topics published ·{" "}
                    <a
                      class="page__link"
                      href={`/roadmap/#stage-${stage.number}`}
                    >
                      See the stage
                    </a>
                  </p>
                  <ul class="post-list">
                    {stagePosts.map((post) => (
                      <PostCard post={post} />
                    ))}
                  </ul>
                </section>
              ))}
              {otherPosts.length > 0 && (
                <section class="page__section" aria-labelledby="other-heading">
                  <h2 id="other-heading" class="page__section-title">
                    {stageGroups.length > 0 ? "Other posts" : "All posts"}
                  </h2>
                  <ul class="post-list">
                    {otherPosts.map((post) => (
                      <PostCard post={post} />
                    ))}
                  </ul>
                </section>
              )}
            </>
          )
        }
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .post-group__meta {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .post-list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
</style>

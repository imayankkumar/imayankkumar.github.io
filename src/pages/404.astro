---
import BaseLayout from "../layouts/BaseLayout.astro"
import Container from "../components/layout/Container.astro"
import Button from "../components/ui/Button.astro"
import { getPublishedPosts, postUrl } from "../lib/blog"

// Send lost visitors to the learning pages, not a dead end.
const [latest] = await getPublishedPosts()
---

<BaseLayout
  title="Page not found · Mayank Kumar"
  description="This page doesn't exist on imayankkumar.com."
>
  <meta slot="head" name="robots" content="noindex" />
  <main class="page">
    <Container>
      <div class="page__inner">
        <p class="page__eyebrow">404</p>
        <h1 class="page__title">This page doesn't exist</h1>
        <p class="page__lead">
          The link may be old or mistyped. Here's where you can go instead.
        </p>
        <div class="not-found__actions">
          <Button href="/roadmap/">Start the roadmap</Button>
          <Button href="/interview/" variant="secondary"
            >Practice interview questions</Button
          >
        </div>
        {
          latest && (
            <p class="not-found__latest">
              Or read the latest post:{" "}
              <a class="page__link" href={postUrl(latest)}>
                {latest.data.title}
              </a>
            </p>
          )
        }
        <p class="not-found__latest">
          <a class="page__link" href="/">Go to the homepage</a>
        </p>
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .not-found__latest {
    margin-top: var(--space-6);
    color: var(--color-text-secondary);
  }
</style>

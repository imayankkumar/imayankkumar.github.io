---
import "../styles/global.css"
import SEO from "../seo/SEO.astro"
import Header from "../components/navigation/Header.astro"
import Footer from "../components/layout/Footer.astro"
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url"

export interface Props {
  title: string
  description?: string
  type?: "website" | "article"
  image?: string
  imageAlt?: string
}

const {
  title,
  description = "Personal website of Mayank Kumar",
  type = "website",
  image,
  imageAlt,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Start the main text font early so the swap from the fallback font is quicker -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} type={type} image={image} imageAlt={imageAlt} />
    <script is:inline>
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem("theme")
        } catch (e) {}
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
        document.documentElement.dataset.theme = theme
      })()
    </script>
    <slot name="head" />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
    <!-- Cloudflare Web Analytics: cookieless page-view counts -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "77344d67fb13414c804f119325702698"}'
    ></script>
  </body>
</html>
